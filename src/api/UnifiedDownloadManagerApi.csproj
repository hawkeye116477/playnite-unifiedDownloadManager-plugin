<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>UnifiedDownloadManagerApiNS</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyTitle>UnifiedDownloadManagerApi</AssemblyTitle>
    <Product>UnifiedDownloadManagerApi</Product>
    <Copyright>Copyright © 2026 hawkeye116477</Copyright>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.0.3.11</Version>
  </PropertyGroup>
  <PropertyGroup>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/..'))=Dev:/playnite-unified-download-manager-plugin/src/api</PathMap>
    <LocalAppData>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))</LocalAppData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Playnite.SDK" Version="11.0.0-alpha14" />
  </ItemGroup>
</Project>