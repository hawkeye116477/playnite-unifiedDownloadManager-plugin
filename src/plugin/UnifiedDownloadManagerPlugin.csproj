<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>UnifiedDownloadManagerNS</RootNamespace>
        <AssemblyName>UnifiedDownloadManager</AssemblyName>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AssemblyTitle>UnifiedDownloadManager</AssemblyTitle>
        <Product>UnifiedDownloadManager</Product>
        <Copyright>Copyright © 2026 hawkeye116477</Copyright>
        <VersionPrefix>2.0.0</VersionPrefix>
        <VersionSuffix>$([System.DateTime]::UtcNow.ToString("yyyyMMdd"))</VersionSuffix>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <LangVersion>default</LangVersion>
        <Configurations>Debug;Release</Configurations>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup>
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/..'))=Dev:/playnite-unified-download-manager-plugin/src/plugin</PathMap>
        <LocalAppData>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))</LocalAppData>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\api\UnifiedDownloadManagerApi.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="extension.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Localization\en_US.ftl">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="pluginicon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="Localization\*\*.ftl">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\third_party\Localization\*\*.ftl">
            <Link>Localization\%(RecursiveDir)\%(Filename)%(Extension)</Link>
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\third_party\CommonLocalization\*\*.ftl">
            <Link>Localization\%(RecursiveDir)\%(Filename)%(Extension)</Link>
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="$(LocalAppData)\Playnite\Templates\Themes\Fonts\icofont.ttf">
            <Link>Fonts/icofont.ttf</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Link>LICENSE</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\ThirdPartyLicenses.txt">
            <Link>ThirdPartyLicenses.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="Resources\icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ByteSize" Version="2.1.2"/>
        <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1"/>
        <PackageReference Include="Linguini.Bundle" Version="0.11.0"/>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Playnite.SDK" Version="11.0.0-alpha14" />
    </ItemGroup>
    <ItemGroup Label="compileInclude3p">
        <Compile Include="..\..\third_party\playnite-common-plugin\src\CommonHelpers.cs" Link="Shared\CommonHelpers.cs"/>
        <Compile Include="..\..\third_party\playnite-common-plugin\src\LocalizationManager.cs" Link="Shared\LocalizationManager.cs"/>
        <Compile Include="..\..\third_party\playnite-common-plugin\src\LocalizeExtension.cs" Link="Shared\LocalizeExtension.cs"/>
        <Compile Include="..\..\third_party\playnite-common-plugin\src\Serialization.cs" Link="Shared\Serialization.cs"/>
        <Compile Include="..\..\third_party\playnite-common-plugin\src\Enums\ClearCacheTime.cs" Link="Shared\Enums\ClearCacheTime.cs"/>
        <None Include="..\..\third_party\playnite-common-plugin\src\Resources\FullScreenStyles.xaml">
            <Link>Shared\Resources\FullScreenStyles.xaml</Link>
            <SubType>Designer</SubType>
            <Generator>MSBuild:Compile</Generator>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>Resources\FullScreenStyles.xaml</TargetPath>
        </None>
        <None Include="..\..\third_party\playnite-common-plugin\src\Resources\NormalStyles.xaml">
            <Link>Shared\Resources\NormalStyles.xaml</Link>
            <SubType>Designer</SubType>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>Resources\NormalStyles.xaml</TargetPath>
            <Generator>MSBuild:Compile</Generator>
        </None>
        <Compile Include="..\..\third_party\Playnite_mod\WindowsNotifyIconManager.cs" Link="Shared\Playnite_mod\WindowsNotifyIconManager.cs"/>
        <Compile Include="..\..\third_party\Playnite_mod\FileSystem.cs" Link="Shared\Playnite_mod\FileSystem.cs"/>
        <Compile Include="..\..\third_party\Playnite_mod\Paths.cs" Link="Shared\Playnite_mod\Paths.cs"/>
        <Compile Include="..\..\third_party\Playnite_mod\ProcessStarter.cs" Link="Shared\Playnite_mod\ProcessStarter.cs"/>
        <Compile Include="..\..\third_party\Playnite_mod\Extensions\StringExtensions.cs" Link="Shared\Playnite_mod\StringExtensions.cs"/>
        <Compile Include="..\..\third_party\Playnite_mod\Xaml.cs" Link="Shared\Playnite_mod\Xaml.cs"/>
    </ItemGroup>
    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml"/>
        <Page Include="App.xaml"/>
    </ItemGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="python &quot;$(ProjectDir)..\..\make_scripts\after_build.py&quot; $(TargetDir)"/>
    </Target>
</Project>